# Google Workspace service account with domain-wide delegation.
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
# Use the deployment secret store. Preserve PEM newlines as supported by the platform.
GOOGLE_WORKSPACE_PRIVATE_KEY=
# Dedicated delegated Workspace identity; do not reuse a personal account.
GOOGLE_WORKSPACE_DELEGATED_USER_EMAIL=
GOOGLE_WORKSPACE_CALENDAR_ID=
GOOGLE_WORKSPACE_SHARED_DRIVE_ID=

# Dedicated machine credential for POST /api/internal/closer-meet/recording-sync.
# Generate at least 32 cryptographically random bytes; never reuse session or Google credentials.
CLOSER_MEET_SYNC_SECRET=

# AES-256-GCM transcript key: canonical base64 of 32 random bytes, plus a non-secret rotation identifier.
CLOSER_MEET_TRANSCRIPT_KEY=
CLOSER_MEET_TRANSCRIPT_KEY_ID=